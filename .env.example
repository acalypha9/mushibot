# Leave empty to proxy browser API requests through Next.js.
NEXT_PUBLIC_API_URL=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=mushibot_db
POSTGRES_PORT=5432
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_API_KEY=replace-with-a-long-random-internal-key
INTERNAL_API_SECRET=replace-with-a-long-random-internal-key
LOG_RAW_MODEL_IO=false
LOG_RAW_MESSAGE_IO=false
ENABLE_SHELL_TOOL=false
