# Runtime-generated uploads and parsed documents (preserve folder structure via .gitkeep)
api/uploads/*
!api/uploads/.gitkeep
api/parsed_outputs/*
!api/parsed_outputs/.gitkeep
public/files/*
!public/files/.gitkeep

# Logs and debug files
logs/
*.log
npm-debug.log*
