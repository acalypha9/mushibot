# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment and secrets
.env
.env.*

# Test and linter caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime-generated files; preserve required directory structure
uploads/*
!uploads/.gitkeep
parsed_outputs/*
!parsed_outputs/.gitkeep

# Logs and temporary files
*.log
*.tmp
